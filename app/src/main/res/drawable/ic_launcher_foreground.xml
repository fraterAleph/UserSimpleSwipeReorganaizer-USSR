<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A tear-off flyer: a notice sheet with a fringe of pull-tabs along the bottom, one
         of them already taken. The whole app is that gesture - take one strip away, leave
         the sheet standing. Drawn on the 72dp safe zone of the 108dp adaptive canvas. -->

    <!-- Hard offset shadow, the same trick the in-app cards use instead of a blur. -->
    <path
        android:fillColor="#4F0014"
        android:pathData="M34,24h44v40h-44z" />

    <!-- The sheet. -->
    <path
        android:fillColor="#F2E4D4"
        android:pathData="M30,20h44v40h-44z" />

    <!-- Two lines of "text" on the notice. -->
    <path
        android:fillColor="#4F0014"
        android:pathData="M36,28h32v5h-32zM36,38h22v3h-22zM36,44h26v3h-26z" />

    <!-- The fringe: five tabs hanging off the bottom edge, split by gaps. -->
    <path
        android:fillColor="#F2E4D4"
        android:pathData="M30,60h7v18h-7zM39,60h7v18h-7zM48,60h7v18h-7zM66,60h8v18h-8z" />

    <!-- The one that has been torn off, fallen and tilted. -->
    <path
        android:fillColor="#C4123A"
        android:pathData="M58,66l7,2l-4,16l-7,-2z" />

    <!-- Perforation marks where the tabs meet the sheet. -->
    <path
        android:fillColor="#C4123A"
        android:pathData="M30,58h44v3h-44z" />
</vector>
